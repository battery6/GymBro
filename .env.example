# Copy to .env and adjust. Loaded by docker compose; .env is gitignored.

# HS256 signing secret for access tokens. MUST be >= 32 bytes. Generate with:
#   openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-please-32bytes-minimum-000

# Only needed if you run the app outside docker compose against a non-default DB:
# DB_URL=jdbc:postgresql://localhost:5432/gymbro
# DB_USERNAME=gymbro
# DB_PASSWORD=gymbro
# REDIS_HOST=localhost
# REDIS_PORT=6379
